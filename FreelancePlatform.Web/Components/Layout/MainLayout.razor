@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg bg-white shadow-sm px-4 py-3">

    <div class="container-fluid">

        <a href="/" class="navbar-brand fw-bold text-success fs-1">
            FreelancePlatform
        </a>

        <div class="d-flex gap-3 align-items-center">

            <a href="/explore" class="btn btn-outline-dark">
                Explorează
            </a>

            @if (isInitialized && isAuthenticated)
            {
                <a href="/orders" class="btn btn-outline-dark">
                    Inbox
                </a>
                <a href="/profile/me"
                       class="btn btn-outline-dark">
                    Profil
                </a>


                <a href = "/my-announcements"
                class= "btn btn-outline-dark" >
                Anunțurile mele
                </a >

                <a href = "/creeaza-anunt"
                class= "btn btn-success" >
                Creează anunț
                </a >

                <button class= "btn btn-outline-danger"
                @onclick = "Logout" >
                Logout
                </button >

}

            else if (isInitialized)
            {
                <a href="/login" class="btn btn-outline-dark">
                    Logare
                </a>

                <a href="/register" class="btn btn-success">
                    Înregistrare
                </a>
            }
           

        </div>

    </div>

</nav>

<div class="container-fluid py-4">
    @Body
</div>

@code {

    private bool isInitialized = false;
    private bool isAuthenticated = false;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += UpdateNavbar;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isAuthenticated = await CheckAuth();
            isInitialized = true;

            StateHasChanged();
        }
    }

    private async Task<bool> CheckAuth()
    {
        var token = await AuthService.GetToken();
        return !string.IsNullOrWhiteSpace(token);
    }

    private async void UpdateNavbar()
    {
        isAuthenticated = await CheckAuth();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= UpdateNavbar;
    }
}