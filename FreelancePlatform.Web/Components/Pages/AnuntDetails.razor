@page "/anunt/{Id:int}"
@rendermode InteractiveServer

@inject AnuntService AnuntService
@inject NavigationManager Navigation
@inject AuthService AuthService

<h2 class="mb-4">Detalii anunț</h2>

@if (anunt == null)
{
    <p>Se încarcă...</p>
}
else
{
    <div class="card shadow p-4">

        <h2>@anunt.Titlu</h2>

        <p class="mt-3">
            @anunt.Descriere
        </p>

        <div class="mt-3">

            <span class="badge bg-primary me-2">
                @anunt.Categorie
            </span>

            <span class="badge bg-dark">
                @anunt.TipAnunt
            </span>

        </div>

        <div class="mt-3">
            <strong>Tehnologii:</strong>
            @anunt.Tehnologii
        </div>

        <div class="mt-3">
            <strong>Buget:</strong>
            @anunt.PretSauBuget €
        </div>

        <div class="mt-3">
            <strong>Publicat:</strong>
            @anunt.DataPublicarii.ToShortDateString()
        </div>

        <div class="mt-3">
            <strong>Utilizator:</strong>
            <a href="/profile/@anunt.UtilizatorId"
                   class="text-decoration-none fw-bold">
                @anunt.NumeUtilizator
            </a>
        </div>

        @if (isLoggedIn)
        {
            @if (isOwner)
            {
                <button class="btn btn-primary mt-4"
                        @onclick="OpenApplications">
                    Vezi aplicațiile
                </button>
            }
            else
            {
                <button class="btn btn-success mt-4"
                        @onclick="GoToApply">
                    Aplică
                </button>
            }
        }

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private AnuntModel? anunt;

    private bool isLoggedIn = false;

    private bool isOwner = false;

    protected override async Task OnInitializedAsync()
    {
        anunt = await AnuntService.GetById(Id);

        var token = await AuthService.GetToken();

        isLoggedIn = !string.IsNullOrWhiteSpace(token);

        if (anunt != null)
        {
            isOwner = await IsOwner(anunt.UtilizatorId);
        }
    }

    private void GoToApply()
    {
        Navigation.NavigateTo($"/apply/{Id}");
    }

    private void OpenApplications()
    {
        Navigation.NavigateTo($"/applications/{Id}");
    }

    private async Task<bool> IsOwner(int ownerId)
    {
        try
        {
            var token = await AuthService.GetToken();

            if (string.IsNullOrWhiteSpace(token))
            {
                return false;
            }

            var payload = token.Split('.')[1];

            payload = payload.PadRight(
                payload.Length + (4 - payload.Length % 4) % 4,
                '=');

            var jsonBytes =
                Convert.FromBase64String(payload);

            var json =
                System.Text.Encoding.UTF8.GetString(jsonBytes);

            using var document =
                System.Text.Json.JsonDocument.Parse(json);

            var userId =
                document.RootElement
                    .GetProperty("nameid")
                    .GetString();

            return int.Parse(userId!) == ownerId;
        }
        catch
        {
            return false;
        }
    }
}