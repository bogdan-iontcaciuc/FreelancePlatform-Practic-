@page "/applications/{AnuntId:int}"
@rendermode InteractiveServer

@inject ApplicationService ApplicationService
@inject OrderService OrderService

<h2 class="mb-4">Aplicații</h2>

@if (!applications.Any())
{
    <div class="alert alert-info">
        Nu există aplicații.
    </div>
}
else
{
    @foreach (var app in applications)
    {
        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <h5>
                    @app.Freelancer
                </h5>

                <p>
                    @app.MesajAplicare
                </p>

                <p>
                    Status:

                    @if (app.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (app.Status == "Respins")
                    {
                        <span class="badge bg-danger">
                            Respins
                        </span>
                    }
                    else if (app.Status == "Acceptat")
                    {
                        <span class="badge bg-success">
                            Acceptat
                        </span>
                    }
                </p>

                @if (app.Status == "Pending")
                {
                    <div class="d-flex gap-2">

                        <button class="btn btn-success"
                                @onclick="() => Accept(app.Id)">
                            Acceptă
                        </button>

                        <button class="btn btn-danger"
                                @onclick="() => Reject(app.Id)">
                            Respinge
                        </button>

                    </div>
                }

            </div>

        </div>
    }
}

@code {

    [Parameter]
    public int AnuntId { get; set; }

    private List<ApplicationModel> applications = new();

    protected override async Task OnInitializedAsync()
    {
        applications =
            await ApplicationService
                .GetApplications(AnuntId);
    }

    private async Task Accept(int applicationId)
    {
        await OrderService
            .CreateFromApplication(applicationId);

        applications =
            await ApplicationService
                .GetApplications(AnuntId);
    }
    private async Task Reject(int applicationId)
    {
        var response = await ApplicationService
            .RejectApplication(applicationId);

        if (response.IsSuccessStatusCode)
        {
            applications =
                await ApplicationService
                    .GetApplications(AnuntId);
        }
    }
}