@page "/home"
@inject AnuntService AnuntService

<div class="container mt-5">

    <div class="hero-section text-center mb-5">

        <h1 class="display-4 fw-bold">
            Găsește freelancerul perfect
        </h1>

        <p class="text-muted fs-5 mt-3">
            Servicii IT pentru web, aplicații desktop,
            Unity, baze de date și multe altele.
        </p>

        <div class="d-flex justify-content-center mt-4 gap-3">

            <button class="btn btn-success btn-lg px-4">
                Caută servicii
            </button>

            <button class="btn btn-dark btn-lg px-4">
                Publică anunț
            </button>

        </div>

    </div>

    <div class="row">

        @if (anunturi.Any())
        {
            @foreach (var anunt in anunturi)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card border-0 shadow h-100 custom-card">

                        <div class="card-body d-flex flex-column p-4">

                            <h4 class="fw-bold mb-3">
                                @anunt.Titlu
                            </h4>

                            <p class="text-muted flex-grow-1">
                                @anunt.Descriere
                            </p>

                            <div class="mb-3">

                                <span class="badge bg-primary me-2">
                                    @anunt.Categorie
                                </span>

                                <span class="badge bg-dark">
                                    @anunt.TipAnunt
                                </span>

                            </div>

                            <div class="fw-bold fs-5 text-success">
                                @anunt.PretSauBuget €
                            </div>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>

<style>

    body {
        background-color: #f7f7f7;
    }

    .hero-section {
        padding: 40px 0;
    }

    .custom-card {
        border-radius: 20px;
        transition: 0.25s;
    }

        .custom-card:hover {
            transform: translateY(-6px);
        }

</style>

@code {



    private List<Anunt> anunturi = new();

    protected override async Task OnInitializedAsync()
    {
        anunturi = await AnuntService.GetAll();
    }
    
        public class Anunt
        {
            public string Titlu { get; set; } = "";
            public string Descriere { get; set; } = "";
            public string Categorie { get; set; } = "";
            public string TipAnunt { get; set; } = "";
            public decimal PretSauBuget { get; set; }
        }
}