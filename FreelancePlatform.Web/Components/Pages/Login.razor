@page "/login"

@rendermode InteractiveServer
@layout Layout.AuthLayout

@using System.ComponentModel.DataAnnotations

@inject AuthService AuthService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="login-box">

    <h2 class="text-center">Logare</h2>

    <EditForm Model="@model" OnValidSubmit="HandleLogin">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">
                Email
            </label>

            <InputText @bind-Value="model.Email"
                       class="form-control"
                       placeholder="Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Parola
            </label>

            <InputText @bind-Value="model.Password"
                       class="form-control"
                       type="password"
                       placeholder="Parola" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-3">
            Logare
        </button>

    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert mt-3 @(isSuccess ? "alert-success" : "alert-danger")">
            @message
        </div>
    }

</div>

@code {

    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    private LoginModel model = new();
    private bool isSuccess;
    private string message = "";

    private async Task HandleLogin()
    {
        var response = await AuthService.Login(model.Email, model.Password);

        isSuccess = response.IsSuccessStatusCode;

        if (isSuccess)
        {
            var result = await response.Content.ReadFromJsonAsync<Models.LoginResponse>();

            if (result != null)
            {
                await AuthService.SaveToken(result.Token);
                await AuthService.AddTokenToHeader();

                Navigation.NavigateTo(
    string.IsNullOrWhiteSpace(returnUrl) ? "/" : returnUrl
);
            }
        }
        else
        {
            message = "Email sau parolă incorectă";
        }
    }

    public class LoginModel
    {
        [Required]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}