@page "/my-announcements"
@rendermode InteractiveServer

@inject AnuntService AnuntService

<h2 class="mb-4">Anunțurile mele</h2>

<div class="row">

    @foreach (var anunt in anunturi)
    {
        <div class="col-md-6 mb-4">

            <div class="card border-0 shadow h-100">

                <div class="card-body d-flex flex-column">

                    <h4 class="fw-bold mb-3">
                        @anunt.Titlu
                    </h4>
                    <p class="text-muted flex-grow-1">
                        @anunt.Descriere
                    </p>

                    <div class="mb-3">
                        <span class="badge bg-success">
                            @anunt.Status
                        </span>
                    </div>

                    <div class="d-flex gap-2 mt-auto">

                        
                        <a class="btn btn-success"
                               href="/anunt/@anunt.Id">
                            Detalii
                        </a>
                        <a class="btn btn-warning"
       href="/edit-announcement/@anunt.Id">
        Editare
    </a>

    <button class="btn btn-danger"
            @onclick="() => DeleteAnnouncement(anunt.Id)">
        Șterge
                        </button>

                    </div>

                </div><a class="btn btn-dark"
                     href="/applications/@anunt.Id">
                Vezi aplicațiile
            </a>


        </div>
        
    </div>
}

</div>

@code {

    private List<AnuntModel> anunturi = new();

    protected override async Task OnInitializedAsync()
    {
        anunturi = await AnuntService.GetMine();
    }
    private async Task DeleteAnnouncement(int id)
    {
        var response = await AnuntService.Delete(id);

        if (response.IsSuccessStatusCode)
        {
            anunturi = await AnuntService.GetMine();
        }
    }
}