@page "/profile/me"
@rendermode InteractiveServer

@inject ProfileService ProfileService

@if (isLoading)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-success"></div>
    </div>
}
else if (profile != null)
{
    <div class="profile-wrapper">

        <div class="profile-card">

            <div class="avatar">
                @profile.NumeComplet.Substring(0, 1)
            </div>

            <h1>
                @profile.NumeComplet
            </h1>

            <p>
                @profile.Email
            </p>
            <div class="mt-3">
                <h4>⭐ @profile.AverageRating.ToString("0.0")</h4>
                <p>@profile.TotalReviews review-uri</p>
            </div>

        </div>


        <div class="edit-card">

            <h3 class="mb-4">
                Editare profil
            </h3>

            <EditForm Model="editModel"
                      OnValidSubmit="SaveProfile">

                <div class="mb-4">

                    <label>
                        Nume complet
                    </label>

                    <InputText class="form-control"
                               @bind-Value="editModel.NumeComplet" />

                </div>

                <div class="mb-4">

                    <label>
                        Descriere
                    </label>

                    <InputTextArea class="form-control"
                                   rows="6"
                                   @bind-Value="editModel.Descriere" />

                </div>

                <button class="btn btn-success btn-lg">
                    Salvează profil
                </button>

            </EditForm>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-success mt-4">
                    @message
                </div>
            }
            @if (profile.Reviews.Any())
            {
                <div class="mt-4">
                    <h4>Review-uri primite</h4>

                    @foreach (var r in profile.Reviews)
                    {
                        <div class="card p-3 mb-2">

                            <strong>@r.ReviewerName</strong>

                            <div>
                                @for (int i = 0; i < r.Rating; i++)
                                {
                                    <span>⭐</span>
                                }
                            </div>

                            <p>@r.Comentariu</p>

                        </div>
                    }
                </div>
            }

        </div>

    </div>
}

<style>

    body {
        background: #f4f7fb;
    }

    .profile-wrapper {
        max-width: 1000px;
        margin: auto;
    }

    .profile-card {
        background: white;
        border-radius: 30px;
        padding: 50px;
        text-align: center;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: #198754;
        color: white;
        margin: auto;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 50px;
        font-weight: bold;
    }

    .edit-card {
        background: white;
        border-radius: 30px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .form-control {
        border-radius: 15px;
        padding: 14px;
    }

</style>

@code {

    private bool isLoading = true;

    private ProfileModel? profile;

    private UpdateProfileModel editModel
        = new();

    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        profile = await ProfileService.GetMyProfile();

        if (profile != null)
        {
            editModel.NumeComplet =
                profile.NumeComplet;

            editModel.Descriere =
                profile.Descriere;
        }

        isLoading = false;
    }

    private async Task SaveProfile()
    {
        var response =
            await ProfileService
                .UpdateProfile(editModel);

        if (response.IsSuccessStatusCode)
        {
            message = "Profil actualizat.";

            profile = await ProfileService
                .GetMyProfile();
        }
    }

}