@page "/orders"
@rendermode InteractiveServer
@inject OrderService OrderService

<h2 class="mb-4">Inbox / Orders</h2>

@if (!orders.Any())
{
    <div class="alert alert-info">
        Nu există order-uri.
    </div>
}
else
{

    <div class="row">

        ```
        @foreach (var order in orders)
        {
            <div class="col-lg-6 mb-4">

                <div class="card border-0 shadow h-100 custom-card">

                    <div class="card-body d-flex flex-column p-4">

                        <h4 class="fw-bold mb-3">
                            @order.TitluAnunt
                        </h4>

                        <div class="mb-3">

                            <span class="badge bg-primary me-2">
                                @order.Categorie
                            </span>

                            <span class="badge bg-dark">
                                @order.TipAnunt
                            </span>

                        </div>

                        <div class="fw-bold fs-5 text-success mb-3">
                            @order.PretSauBuget €
                        </div>

                        <div class="mb-3">

                            @if (order.Status == "InProgress")
                            {
                                <span class="badge bg-warning text-dark">
                                    În lucru
                                </span>
                            }
                            else if (order.Status == "Delivered")
                            {
                                <span class="badge bg-info text-dark">
                                    Livrat
                                </span>
                            }
                            else if (order.Status == "Completed")
                            {
                                <span class="badge bg-success">
                                    Finalizat
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @order.Status
                                </span>
                            }

                        </div>

                        <small class="text-muted mb-4">
                            Creat:
                            @order.CreatedAt.ToLocalTime()
                        </small>

                        <a class="btn btn-success mt-auto"
                               href="/chat/@order.Id">
                            Deschide conversația
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>


}

<style>

    .custom-card {
        border-radius: 20px;
        transition: 0.25s;
    }

    .custom-card:hover {
        transform: translateY(-5px);
    }

</style>

@code {


private List<OrderModel> orders = new();

    protected override async Task OnInitializedAsync()
    {
        orders = await OrderService.GetOrders();
    }


}
