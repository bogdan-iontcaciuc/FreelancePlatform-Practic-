@page "/register"
@layout Layout.AuthLayout

<div class="login-box">
    <h2>Înregistrare</h2>

    <EditForm Model="@model" OnValidSubmit="HandleRegister">
        <InputText @bind-Value="model.Email" placeholder="Email" class="form-control" />
        <br />
        <InputText @bind-Value="model.FullName" placeholder="Nume complet" class="form-control" />
        <br />
        <InputText @bind-Value="model.Password" type="password" placeholder="Parola" class="form-control" />
        <br />
        <InputText @bind-Value="model.ConfirmPassword" type="password" placeholder="Repetă parola" class="form-control" />
        <br />

        <button class="btn btn-success w-100">Înregistrare</button>
    </EditForm>

    <p class="mt-3 text-center">
        Ai deja cont?
        <a href="/login">Logare</a>
    </p>
</div>

@code {
    private RegisterModel model = new();

    private void HandleRegister() { }

    class RegisterModel
    {
        public string Email { get; set; }
        public string FullName { get; set; }
        public string Password { get; set; }
        public string ConfirmPassword { get; set; }
    }
}